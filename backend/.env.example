# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/codeguardian

# JWT Authentication Secret (Must be strong and secret in production)
JWT_SECRET=your_secure_random_secret_here

# AI Service (FastAPI) URL
AI_SERVICE_URL=http://localhost:8000

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AI=30
RATE_LIMIT_MAX_AUTH=15
